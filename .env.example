# EventReport — variables de entorno
# Copiar a apps/web/.env.local y completar. Nunca commitear valores reales.

# ---------------------------------------------------------------- Supabase
# URL del proyecto. Publica: se expone al navegador.
# Desarrollo: https://xhprvnpmyrwsxdzhprqu.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publishable (anon). Publica: solo funciona con RLS activa.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role. SECRETA: solo en Edge Functions y en el servidor.
# Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Sitio
# Origen publico, usado en metadatos y en los enlaces de los correos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------- Motor de informes
# Clave de Anthropic para el pipeline de informes (fase 3).
ANTHROPIC_API_KEY=
